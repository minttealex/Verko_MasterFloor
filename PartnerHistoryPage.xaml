<Page x:Class="Verko_MasterFloor.PartnerHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Verko_MasterFloor"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="История реализации продукции" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding PartnerInfo}" FontSize="18" Margin="10" HorizontalAlignment="Center"/>

        <ListView Name="HistoryListView" Grid.Row="1" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Наименование продукции" Width="300" 
                                    DisplayMemberBinding="{Binding Products.ProductName}"/>
                    <GridViewColumn Header="Артикул" Width="100" 
                                    DisplayMemberBinding="{Binding Products.ProductArticle}"/>
                    <GridViewColumn Header="Количество" Width="100" 
                                    DisplayMemberBinding="{Binding ProductQuantity, StringFormat={}{0} шт.}"/>
                    <GridViewColumn Header="Дата продажи" Width="120" 
                                    DisplayMemberBinding="{Binding SellDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                    <GridViewColumn Header="Тип продукции" Width="150" 
                                    DisplayMemberBinding="{Binding Products.ProductTypes.ProductTypeName}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>